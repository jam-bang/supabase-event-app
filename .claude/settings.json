{
  "permissions": {
    "allow": ["Bash(npm run lint)", "Bash(npm run typecheck)", "Bash(npm run build)", "Bash(git status:*)", "Bash(git diff:*)"],
    "deny": ["Read(./.env.local)", "Edit(./.env.local)", "Write(./.env.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-files.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-file.mjs"
          }
        ]
      }
    ]
  }
}
